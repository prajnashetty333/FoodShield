# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node and frontend build output
node_modules/
frontend/node_modules/
frontend/dist/

# Logs and temporary files
*.log
*.tmp
*.temp
build/

# Data folders
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/foodshield/
/data/processed/foodshield/*
!/data/processed/foodshield/.gitkeep
!/data/processed/foodshield/foodshield_resilience_metrics_2010_2023.csv
!/data/processed/foodshield/foodshield_research_findings_2010_2023.csv
!/data/processed/foodshield/foodshield_replacement_results_2010_2023.csv
!/data/processed/foodshield/foodshield_supplier_shock_2010_2023.csv
!/data/processed/foodshield/foodshield_exposure_metrics_2010_2023.csv
!/data/processed/foodshield/foodshield_sensitivity_summary_2010_2023.csv
!/data/processed/foodshield/foodshield_sensitivity_profile_transitions_2010_2023.csv
/data/external/*
!/data/external/.gitkeep

# Outputs
/outputs/figures/*
!/outputs/figures/.gitkeep
/outputs/tables/*
!/outputs/tables/.gitkeep
/outputs/models/*
!/outputs/models/.gitkeep

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Environment
.env
.env.*
!.env.example
!**/.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# OS generated files
.DS_Store
Thumbs.db
