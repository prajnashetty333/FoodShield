# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node and frontend build output
node_modules/
frontend/node_modules/
frontend/dist/

# Logs and temporary files
*.log
*.tmp
*.temp

# Data folders
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/external/*
!/data/external/.gitkeep

# Outputs
/outputs/figures/*
!/outputs/figures/.gitkeep
/outputs/tables/*
!/outputs/tables/.gitkeep
/outputs/models/*
!/outputs/models/.gitkeep

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Environment
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# OS generated files
.DS_Store
Thumbs.db
